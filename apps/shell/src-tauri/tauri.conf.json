{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leak",
  "version": "0.1.0",
  "identifier": "io.github.mohammedanasasif.leak",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "News",
    "shortDescription": "World news, the moment it breaks",
    "longDescription": "Leak groups every outlet's coverage of each story, updated every few minutes. Open source, no ads, no tracking.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
