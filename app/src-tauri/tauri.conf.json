{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leak",
  "version": "0.1.0",
  "identifier": "com.mohammedanasasif.leak",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Leak — Live World News",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "News",
    "shortDescription": "The world, the moment it happens.",
    "longDescription": "Leak is a real-time world news magazine. A Rust engine watches hundreds of global sources and pushes new stories to your device the moment they break.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
